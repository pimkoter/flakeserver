{
  self,
  inputs,
  ...
}: let
  name = "AA_blueprint";
in {
  flake.nixosConfigurations.${name} = inputs.nixpkgs.lib.nixosSystem {
    modules = with self.nixosModules; [
      {config.currentHost = name;}
      # Default modules
      autoUpgrade
      boot
      disko
      miscellaneous
      networking
      pkgs
      preservation
      shell
      users
      settings

      # Host specific modules
    ];
  };
}
